#!/usr/bin/env bash
# Blocks commits whose staged content contains a student ID.

PATTERN='(^|[^0-9])800[0-9]{6}(_[A-Za-z0-9-]+)?([^0-9]|$)'
FOUND=0

while IFS= read -r -d '' FILE; do
    if git show ":$FILE" 2>/dev/null | grep -aEq "$PATTERN"; then
        echo "BLOCKED: possible student ID in $FILE"
        FOUND=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "COMMIT BLOCKED: remove student information before committing."
    exit 1
fi

exit 0
